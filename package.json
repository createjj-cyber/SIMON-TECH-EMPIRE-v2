{
  "name": "simon-tech-empire",
  "version": "2.0.0",
  "description": "Advanced WhatsApp automation platform with Telegram-based pairing, secure account management, and powerful messaging tools",
  "main": "apps/api/server.js",
  "type": "module",
  "scripts": {
    "start": "node apps/api/server.js",
    "dev": "nodemon apps/api/server.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:load": "jest tests/load",
    "test:security": "jest tests/security",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\"",
    "db:migrate": "node database/migrations/run.js",
    "db:seed": "node database/migrations/seed.js",
    "backup": "node scripts/backup/backup.js",
    "restore": "node scripts/restore/restore.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy": "node scripts/deploy/deploy.js"
  },
  "keywords": [
    "whatsapp",
    "telegram",
    "automation",
    "api",
    "bot"
  ],
  "author": "Simon Tech Empire",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "mongoose": "^7.5.0",
    "redis": "^4.6.10",
    "telegraf": "^4.14.1",
    "whatsapp-web.js": "^1.26.1",
    "axios": "^1.5.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.0",
    "bull": "^4.11.3",
    "node-cron": "^3.0.2",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "puppeteer": "^21.1.1",
    "socket.io": "^4.7.1",
    "joi": "^17.10.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "@faker-js/faker": "^8.2.0",
    "artillery": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
